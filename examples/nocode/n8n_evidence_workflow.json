{
 "name": "ARC-AMPE evidence push (example)",
 "nodes": [
  {
   "id": "1",
   "name": "Every day 06:00",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 6 * * *"
      }
     ]
    }
   }
  },
  {
   "id": "2",
   "name": "Read source",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    220,
    0
   ],
   "parameters": {
    "method": "GET",
    "url": "={{$env.SOURCE_URL}}"
   }
  },
  {
   "id": "3",
   "name": "Map to evidence",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3,
   "position": [
    440,
    0
   ],
   "parameters": {
    "values": {
     "string": [
      {
       "name": "id",
       "value": "={{$json.id}}"
      },
      {
       "name": "source",
       "value": "nocode_n8n"
      },
      {
       "name": "category",
       "value": "webhook"
      },
      {
       "name": "kind",
       "value": "={{$json.kind}}"
      },
      {
       "name": "subject",
       "value": "={{$json.subject}}"
      },
      {
       "name": "observed_at",
       "value": "={{$json.date}}"
      }
     ]
    }
   }
  },
  {
   "id": "4",
   "name": "Sign",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    0
   ],
   "parameters": {
    "jsCode": "// Build X-ArcAmpe-Signature: t=<ts>,v1=<hmac>\nconst crypto = require('crypto');\nconst body = JSON.stringify($json);\nconst ts = Math.floor(Date.now() / 1000);\nconst mac = crypto.createHmac('sha256', $env.ARCAMPE_WEBHOOK_SECRET).update(`${ts}.${body}`).digest('hex');\nreturn [{ json: { body, header: `t=${ts},v1=${mac}` } }];"
   }
  },
  {
   "id": "5",
   "name": "POST to ARC-AMPE",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    880,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "https://grc.lakehaven-hx.example/hooks/evidence",
    "sendBody": true,
    "contentType": "raw",
    "body": "={{$json.body}}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-ArcAmpe-Signature",
       "value": "={{$json.header}}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    }
   }
  }
 ],
 "connections": {
  "Every day 06:00": {
   "main": [
    [
     {
      "node": "Read source",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Read source": {
   "main": [
    [
     {
      "node": "Map to evidence",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Map to evidence": {
   "main": [
    [
     {
      "node": "Sign",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Sign": {
   "main": [
    [
     {
      "node": "POST to ARC-AMPE",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "note": "Example only. Set ARCAMPE_WEBHOOK_SECRET and SOURCE_URL in n8n credentials/env."
 }
}
