{
  "displayName": "ARC-AMPE: storage requires TLS 1.2",
  "mode": "Indexed",
  "metadata": {
    "category": "ARC-AMPE (synthetic demo)",
    "version": "1.0.0",
    "arcampeCheck": "AZ-04",
    "controls": [
      "SC-08",
      "SC-08(01)"
    ]
  },
  "parameters": {
    "effect": {
      "type": "String",
      "allowedValues": [
        "Audit",
        "Deny",
        "Disabled"
      ],
      "defaultValue": "Audit",
      "metadata": {
        "displayName": "Effect"
      }
    }
  },
  "policyRule": {
    "if": {
      "allOf": [
        {
          "field": "type",
          "equals": "Microsoft.Storage/storageAccounts"
        },
        {
          "field": "Microsoft.Storage/storageAccounts/minimumTlsVersion",
          "notEquals": "TLS1_2"
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  }
}
